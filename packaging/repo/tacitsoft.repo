# TacitSoft yum/dnf repository (shared pool — select the product by package
# name, e.g. `dnf install wmaker-ng`). $releasever/$basearch resolve per host;
# el8 tree = glibc 2.28 floor, el9 tree = 2.34 (EL10 users pin $releasever=9).
# Drop into /etc/yum.repos.d/tacitsoft.repo.
[tacitsoft]
name=TacitSoft
baseurl=https://repos.tacitsoft.dev/rpm/el/$releasever/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://repos.tacitsoft.dev/keys/tacitsoft.gpg
