# Maintainer: The wmaker-ng Team <ops@tacitsoft.dev>
pkgname=wmaker-ai-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='MCP AI control plane for GNU Window Maker'
arch=('x86_64' 'aarch64')
url='https://github.com/tacitness/wmaker-ng'
license=('GPL-2.0-or-later')
depends=('wmaker-ng-bin')
provides=('wmaker-ai')
conflicts=('wmaker-ai')
source_x86_64=("wmaker-ng-${pkgver}-amd64-gnu.tar.gz::${url}/releases/download/v${pkgver}/wmaker-ng-${pkgver}-amd64-gnu.tar.gz")
source_aarch64=("wmaker-ng-${pkgver}-arm64-gnu.tar.gz::${url}/releases/download/v${pkgver}/wmaker-ng-${pkgver}-arm64-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local stage="wmaker-ng-${pkgver}-amd64-gnu"
  if [[ "${CARCH}" == "aarch64" ]]; then
    stage="wmaker-ng-${pkgver}-arm64-gnu"
  fi

  install -Dm0755 "${srcdir}/${stage}/ai-mcp" "${pkgdir}/usr/bin/ai-mcp"
  install -Dm0644 "${srcdir}/${stage}/README.md" "${pkgdir}/usr/share/doc/wmaker-ai/README.md"
  install -Dm0644 "${srcdir}/${stage}/ARCHITECTURE.md" "${pkgdir}/usr/share/doc/wmaker-ai/ARCHITECTURE.md"
}
